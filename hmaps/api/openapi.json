      }
     }
    ],
    "responses": {
     "200": {
      "description": "הצעות",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "suggestions": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string",
              "examples": [
               "poi-123",
               "place-5",
               "street-9",
               "addr-9-50"
              ]
             },
             "type": {
              "type": "string",
              "enum": [
               "poi",
               "place",
               "street",
               "address",
               "category",
               "coordinate",
               "trail"
              ]
             },
             "name": {
              "type": "string"
             },
             "secondary": {
              "type": "string"
             },
             "category": {
              "type": "string"
             },
             "sub_category": {
              "type": "string"
             },
             "icon": {
              "type": "string"
             },
             "color": {
              "type": "string"
             },
             "location": {
              "$ref": "#/components/schemas/LatLon"
             },
             "distance": {
              "type": [
               "integer",
               "null"
              ]
             },
             "open_now": {
              "type": [
               "boolean",
               "null"
              ]
             },
             "kosher": {
              "type": [
               "boolean",
               "null"
              ]
             },
             "score": {
              "type": [
               "number",
               "null"
              ]
             }
            }
           }
          },
          "query_time_ms": {
           "type": "number"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "פרמטר שגוי",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/api/search": {
   "get": {
    "summary": "חיפוש מלא",
