  "/api/elevation": {
   "get": {
    "summary": "גובה נקודות או פרופיל גובה לאורך קו (Copernicus DEM)",
    "parameters": [
     {
      "name": "points",
      "in": "query",
      "required": false,
      "description": "lat,lon|lat,lon|… (עד 1000 נקודות)",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "path",
      "in": "query",
      "required": false,
      "description": "קו מקודד (Google polyline, דיוק 5)",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "samples",
      "in": "query",
      "required": false,
      "description": "מספר דגימות לאורך הקו (2–500, ברירת מחדל 200)",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "גבהים (points) או פרופיל (path)",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "elevations": {
           "type": "array",
           "items": {
            "type": "number"
           }
          },
          "distance": {
           "type": "number"
          },
          "ascent": {
           "type": "number"
          },
          "descent": {
           "type": "number"
          },
          "min": {
           "type": "number"
          },
          "max": {
           "type": "number"
          },
          "profile": {
           "type": "array",
           "description": "[מרחק במטרים, גובה, lon, lat]",
           "items": {
            "type": "array",
            "items": {
             "type": "number"
            }
           }
          },
          "unit": {
           "type": "string"
          },
          "attribution": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "פרמטר שגוי",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "נתוני הגובה לא הותקנו"
     }
    }
   },
   "post": {
    "summary": "כמו GET, בגוף JSON (לקווים ארוכים)",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "coordinates": {
          "type": "array",
          "description": "[[lon, lat], …] כמו ב-GeoJSON",
          "items": {
           "type": "array",
           "items": {
            "type": "number"
           }
          }
         },
         "points": {
          "type": "array",
          "description": "[[lat, lon], …]",
          "items": {
           "type": "array",
           "items": {
            "type": "number"
           }
          }
         },
         "samples": {
          "type": "integer"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "גבהים או פרופיל",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "פרמטר שגוי",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/tiles/base.json": {
   "get": {
    "summary": "TileJSON של מפת הבסיס",
    "responses": {
     "200": {
      "description": "TileJSON",
