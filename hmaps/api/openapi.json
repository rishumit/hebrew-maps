       "type": "string"
      }
     },
     {
      "name": "lat",
      "in": "query",
      "required": false,
      "description": "מרכז המפה",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "lon",
      "in": "query",
      "required": false,
      "description": "מרכז המפה",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "user_lat",
      "in": "query",
      "required": false,
      "description": "מיקום המשתמש",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "user_lon",
      "in": "query",
      "required": false,
      "description": "מיקום המשתמש",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "category",
      "in": "query",
      "required": false,
      "description": "סינון לפי קטגוריה/תת-קטגוריה",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "kosher",
      "in": "query",
      "required": false,
      "description": "רק כשר",
      "schema": {
       "type": "boolean"
      }
     },
     {
      "name": "open_now",
      "in": "query",
      "required": false,
      "description": "פתוח עכשיו",
      "schema": {
       "type": "boolean"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "description": "גודל עמוד",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "description": "היסט",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "תוצאות",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "results": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string",
              "examples": [
               "poi-123",
               "place-5",
               "street-9",
               "addr-9-50"
              ]
             },
             "type": {
              "type": "string",
              "enum": [
               "poi",
               "place",
               "street",
               "address",
               "category",
               "coordinate",
               "trail"
              ]
             },
             "name": {
              "type": "string"
             },
             "secondary": {
              "type": "string"
             },
             "category": {
              "type": "string"
             },
             "sub_category": {
              "type": "string"
             },
             "icon": {
              "type": "string"
             },
             "color": {
              "type": "string"
             },
             "location": {
              "$ref": "#/components/schemas/LatLon"
             },
             "distance": {
              "type": [
               "integer",
               "null"
              ]
             },
             "open_now": {
              "type": [
               "boolean",
               "null"
              ]
             },
             "kosher": {
              "type": [
               "boolean",
               "null"
              ]
             },
             "score": {
              "type": [
               "number",
               "null"
              ]
             }
            }
           }
          },
          "meta": {
           "type": "object"
          },
          "interpretation": {
           "type": "object",
           "description": "איך השאילתה פורשה (קטגוריה, כתובת, תיקון כתיב...)"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "פרמטר שגוי",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "חיפוש מלא (גוף JSON)",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "query": {
          "type": "string"
         },
         "location": {
          "$ref": "#/components/schemas/LatLon"
         },
         "user_location": {
          "$ref": "#/components/schemas/LatLon"
         },
         "filters": {
          "type": "object",
          "properties": {
           "category": {
            "type": "string"
           },
           "kosher": {
            "type": "boolean"
           },
           "open_now": {
            "type": "boolean"
           }
          }
         },
         "limit": {
          "type": "integer"
         },
         "offset": {
          "type": "integer"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "תוצאות",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "פרמטר שגוי",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
