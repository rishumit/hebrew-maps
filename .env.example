# Copy to ".env" to change settings.
HMAPS_PORT=8080            # web address: http://localhost:8080
PLANETILER_MEMORY=3g       # memory for building the basemap (Docker Desktop needs ~6 GB in total)
HMAPS_LOG_LEVEL=INFO
HMAPS_RATE_PER_SEC=20      # API requests per second per client
HMAPS_RATE_BURST=80
# HMAPS_DOMAIN=maps.example.org   # only for the optional public HTTPS profile
